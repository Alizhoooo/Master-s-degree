{
  "name": "supplyflow-backend",
  "version": "1.0.0",
  "description": "SupplyFlow BPM System Backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rbac": "jest rbac-integration",
