generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  Accountant
  Cashier
  Manager
  Warehouse
  HR
  Production
}

enum ProductType {
  Material
  Goods
  Product
  Service
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String
  fullName            String
  role                UserRole  @default(Warehouse)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  // 2FA
  totpSecret          String?
  totpEnabled         Boolean   @default(false)

  // Password reset
  resetToken          String?   @unique
  resetTokenExpiry    DateTime?

  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Last login
  lastLoginAt DateTime?
  deletedAt   DateTime?

  orders              Order[]
  inventoryLogs       InventoryLog[]
  systemLogs          SystemLog[]
  contactLogs         ContactLog[]
  tasksAssigned       Task[]               @relation("AssignedTo")
  tasksCreated        Task[]               @relation("CreatedBy")
  notifications       Notification[]
  approvalsGiven      DocumentApproval[]
  documentVersions    DocumentVersion[]
  payrollEntries      PayrollEntry[]
  employee            Employee?
  postedDocuments     Document[]           @relation("PostedBy")
  unpostedDocuments   Document[]           @relation("UnpostedBy")
  cashOrdersCreated   CashOrder[]
  bankOrdersCreated   BankOrder[]
  batchesCreated      Batch[]
  productReceipts     ProductReceipt[]
  productIssues       ProductIssue[]
  workshop            Workshop?            @relation("WorkshopHead")
  roleAssignments     UserRoleAssignment[]
  documentsCreated    Document[]           @relation("DocumentCreatedBy")
  productTransfers    ProductTransfer[]
  refreshTokens       RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userEmail  String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

model Customer {
  id            Int            @id @default(autoincrement())
  company       String
  contactPerson String
  phone         String
  email         String
  inn           String?        @unique
  kpp           String?
  address       String?
  tier          String         @default("Regular")
  totalOrders   Int            @default(0)
  lastOrderDate DateTime?
  createdAt     DateTime       @default(now())
  orders        Order[]
  contactLogs   ContactLog[]
  complaints    Complaint[]
  contracts     Contract[]
  settlements   Settlement[]
  documents     Document[]
  ProductIssue  ProductIssue[]
  deletedAt     DateTime?
}

model Supplier {
  id            Int              @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  inn           String?          @unique
  address       String?
  bankAccount   String?
  bankName      String?
  bic           String?
  category      String           @default("General")
  rating        Int              @default(5)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  receipts      ProductReceipt[]
  deletedAt     DateTime?
}

model ContactLog {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  note       String
  createdAt  DateTime @default(now())
}

model Complaint {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}

model Product {
  id                Int                   @id @default(autoincrement())
  sku               String                @unique
  artikul           String?               @unique
  barcode           String?               @unique
  name              String
  description       String?
  category          String
  type              ProductType           @default(Goods)
  unit              String                @default("шт")
  unitPrice         Float
  costPrice         Float                 @default(0)
  markup            Float                 @default(0)
  currency          String                @default("KZT")
  quantityOnHand    Int
  quantityReserved  Int                   @default(0)
  reorderPoint      Int                   @default(5)
  minStock          Int                   @default(0)
  maxStock          Int?
  vatRate           Float                 @default(12)
  weight           Float?
  volume           Float?
  manufacturer     String?
  country          String?        @default("KZ")
  imageUrl         String?
  storageLifeDays  Int?
  isActive         Boolean        @default(true)
  archivedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt           DateTime? @updatedAt
  orderItems        OrderItem[]
  inventoryLogs     InventoryLog[]
  batches           Batch[]
  productionInputs  ProductBomInput[]
  productionOutputs ProductionOutput[]
  stockMovements    StockMovement[]
  documentItems     DocumentItem[]
  productReceipts   ProductReceiptItem[]
  productIssues     ProductIssueItem[]
  stockBalances     StockBalance[]
  transferItems     ProductTransferItem[]
  expiryAlerts      ExpiryAlert[]
  techCards         TechCard[]            @relation("TechCardOutput")
  deletedAt         DateTime?

  @@index([category])
  @@index([isActive])
  @@index([quantityOnHand])
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("Pending")
  totalAmount     Float
  costAmount      Float
  deliveryAddress String
  deadline        DateTime
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt           DateTime? @updatedAt
  items           OrderItem[]
  deletedAt       DateTime?

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  vatAmount Float   @default(0)
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  change    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  stockMovements      StockMovement[]
  productReceipts     ProductReceipt[]
  productIssues       ProductIssue[]
  productReceiptItems ProductReceiptItem[]
  productIssueItems   ProductIssueItem[]
  stockBalances       StockBalance[]
  transfersFrom       ProductTransfer[]    @relation("TransferFrom")
  transfersTo         ProductTransfer[]    @relation("TransferTo")
}

model StockBalance {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  updatedAt           DateTime? @updatedAt

  @@unique([warehouseId, productId])
}

enum StockMovementType {
  Receipt
  Issue
  TransferIn
  TransferOut
  WriteOff
  Inventory
  Adjustment
  Production
  Return
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta       Int
  type        StockMovementType @default(Adjustment)
  reason      String?
  reference   String?
  balance     Int?
  userId      Int?
  createdAt   DateTime          @default(now())

  @@index([warehouseId, createdAt])
  @@index([productId])
  @@index([type])
}

model Batch {
  id              Int             @id @default(autoincrement())
  productId       Int
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNo         String          @unique
  manufacturedAt  DateTime?
  expiryDate      DateTime?
  storageLifeDays Int?
  quantity        Int             @default(0)
  remainingQty    Int             @default(0)
  costPrice       Float           @default(0)
  receiptId       Int?
  receipt         ProductReceipt? @relation(fields: [receiptId], references: [id])
  status          String          @default("Active")
  notes           String?
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?
  userId          Int?
  user            User?           @relation(fields: [userId], references: [id])

  movements           BatchMovement[]
  receiptItems        ProductReceiptItem[]  @relation("ReceiptItemBatch")
  issueItems          ProductIssueItem[]    @relation("IssueItemBatch")
  expiryAlerts        ExpiryAlert[]
  ProductTransferItem ProductTransferItem[]

  @@index([productId, status])
  @@index([productId, expiryDate])
}

model BatchMovement {
  id        Int      @id @default(autoincrement())
  batchId   Int
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}

model ProductTransfer {
  id              Int                   @id @default(autoincrement())
  number          String                @unique
  date            DateTime              @default(now())
  fromWarehouseId Int
  fromWarehouse   Warehouse             @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   Int
  toWarehouse     Warehouse             @relation("TransferTo", fields: [toWarehouseId], references: [id])
  reason          String?
  status          String                @default("Draft")
  userId          Int
  user            User                  @relation(fields: [userId], references: [id])
  documentId      Int?
  document        Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  items           ProductTransferItem[]
  createdAt       DateTime              @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([number])
}

model ProductTransferItem {
  id         Int             @id @default(autoincrement())
  transferId Int
  transfer   ProductTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product         @relation(fields: [productId], references: [id])
  batchId    Int?
  batch      Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity   Int
  costPrice  Float           @default(0)
}

model ExpiryAlert {
  id         Int       @id @default(autoincrement())
  batchId    Int
  batch      Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  expiryDate DateTime
  daysLeft   Int
  severity   String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([batchId, isResolved])
  @@index([severity])
  @@index([productId])
  @@index([isResolved])
}

model ChartOfAccounts {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  type     String
  parent   String?
  isActive Boolean @default(true)
  vat      Boolean @default(false)

  entries AccountingEntry[]
}

model AccountingEntry {
  id          Int             @id @default(autoincrement())
  accountId   Int
  account     ChartOfAccounts @relation(fields: [accountId], references: [id])
  debit       Float           @default(0)
  credit      Float           @default(0)
  documentId  Int?
  document    Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  period      String
  description String?
  createdAt   DateTime        @default(now())

  @@index([accountId, period])
}

model CashRegister {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  currency  String   @default("KZT")
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  orders CashOrder[]
}

model CashOrder {
  id           Int          @id @default(autoincrement())
  registerId   Int
  register     CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  type         String
  amount       Float
  counterparty String
  basis        String
  documentId   Int?
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
}

model BankAccount {
  id        Int      @id @default(autoincrement())
  name      String
  accountNo String   @unique
  bik       String?
  bankName  String?
  currency  String   @default("KZT")
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  orders     BankOrder[]
  statements BankStatement[]
}

model BankOrder {
  id              Int         @id @default(autoincrement())
  accountId       Int
  account         BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type            String
  amount          Float
  counterparty    String
  counterpartyInn String?
  purpose         String
  documentId      Int?
  document        Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("Pending")
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?
}

model BankStatement {
  id             Int         @id @default(autoincrement())
  accountId      Int
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime
  openingBalance Float
  closingBalance Float
  description    String
  delta          Float
  createdAt      DateTime    @default(now())
}

model Workshop {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  headId    Int?     @unique
  head      User?    @relation("WorkshopHead", fields: [headId], references: [id])
  createdAt DateTime @default(now())

  productionOrders ProductionOrder[]
}

model TechCard {
  id               Int               @id @default(autoincrement())
  name             String
  outputProductId  Int
  outputProduct    Product           @relation("TechCardOutput", fields: [outputProductId], references: [id])
  outputQuantity   Int               @default(1)
  inputs           ProductBomInput[]
  productionOrders ProductionOrder[]
  createdAt        DateTime          @default(now())
  updatedAt           DateTime? @updatedAt
}

model ProductBomInput {
  id         Int      @id @default(autoincrement())
  techCardId Int
  techCard   TechCard @relation(fields: [techCardId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  waste      Float    @default(0)
}

model ProductionOrder {
  id           Int                @id @default(autoincrement())
  number       String             @unique
  techCardId   Int
  techCard     TechCard           @relation(fields: [techCardId], references: [id])
  workshopId   Int
  workshop     Workshop           @relation(fields: [workshopId], references: [id])
  quantity     Int
  status       String             @default("Planned")
  plannedDate  DateTime
  finishedDate DateTime?
  outputs      ProductionOutput[]
  documentId   Int?
  document     Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt           DateTime? @updatedAt
}

model ProductionOutput {
  id                Int             @id @default(autoincrement())
  productionOrderId Int
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  cost              Float
}

model Employee {
  id         Int       @id @default(autoincrement())
  userId     Int?      @unique
  user       User?     @relation(fields: [userId], references: [id])
  fullName   String
  position   String
  department String
  hireDate   DateTime  @default(now())
  fireDate   DateTime?
  salary     Float
  inn        String?   @unique
  phone      String?
  email      String?
  address    String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt  DateTime?

  payrollEntries PayrollEntry[]
  timesheets     Timesheet[]

  @@index([department])
  @@index([isActive])
}

model Timesheet {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  hours      Float
  overtime   Float    @default(0)
  type       String   @default("Regular")
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

model PayrollEntry {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String
  baseSalary Float
  overtime   Float     @default(0)
  bonus      Float     @default(0)
  deductions Float     @default(0)
  tax        Float     @default(0)
  netPay     Float
  status     String    @default("Calculated")
  paidAt     DateTime?
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  documentId Int?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

model Contract {
  id          Int          @id @default(autoincrement())
  number      String       @unique
  customerId  Int
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  signedAt    DateTime
  validUntil  DateTime?
  totalAmount Float
  description String?
  status      String       @default("Active")
  documents   Document[]
  settlements Settlement[]
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
}

model Settlement {
  id          Int       @id @default(autoincrement())
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contractId  Int?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  amount      Float
  type        String
  description String?
  createdAt   DateTime  @default(now())
}

model Document {
  id           Int       @id @default(autoincrement())
  number       String    @unique
  type         String
  date         DateTime  @default(now())
  posted       Boolean   @default(false)
  postedAt     DateTime?
  postedById   Int?
  postedBy     User?     @relation("PostedBy", fields: [postedById], references: [id])
  unpostedById Int?
  unpostedBy   User?     @relation("UnpostedBy", fields: [unpostedById], references: [id])
  customerId   Int?
  customer     Customer? @relation(fields: [customerId], references: [id])
  contractId   Int?
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  description  String?
  totalAmount  Float     @default(0)
  vatAmount    Float     @default(0)
  createdById  Int
  createdBy    User      @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt    DateTime?

  items             DocumentItem[]
  versions          DocumentVersion[]
  approvals         DocumentApproval[]
  accountingEntries AccountingEntry[]
  cashOrders        CashOrder[]
  bankOrders        BankOrder[]
  productionOrders  ProductionOrder[]
  payrollEntries    PayrollEntry[]
  attachments       DocumentAttachment[]
  productReceipts   ProductReceipt[]
  productIssues     ProductIssue[]
  ProductTransfer   ProductTransfer[]

  @@index([type, posted, date])
  @@index([customerId])
  @@index([number])
  @@index([createdById])
}

model DocumentItem {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  vatRate    Float    @default(12)
  vatAmount  Float    @default(0)
  total      Float
}

model DocumentVersion {
  id          Int      @id @default(autoincrement())
  documentId  Int
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  data        Json
  changedById Int
  changedBy   User     @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
}

model DocumentApproval {
  id         Int       @id @default(autoincrement())
  documentId Int
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId Int
  approver   User      @relation(fields: [approverId], references: [id])
  status     String    @default("Pending")
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model DocumentAttachment {
  id          Int      @id @default(autoincrement())
  documentId  Int
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  data        Bytes
  uploadedAt  DateTime @default(now())
}

model ProductReceipt {
  id            Int                  @id @default(autoincrement())
  number        String               @unique
  date          DateTime             @default(now())
  receivedAt    DateTime?
  supplierId    Int?
  supplier      Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName  String
  warehouseId   Int
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
  invoiceNumber String?
  invoiceDate   DateTime?
  contractNo    String?
  currency      String               @default("KZT")
  vatRate       Float                @default(12)
  subtotal      Float                @default(0)
  vatAmount     Float                @default(0)
  totalAmount   Float                @default(0)
  status        String               @default("Draft")
  notes         String?
  userId        Int
  user          User                 @relation(fields: [userId], references: [id])
  documentId    Int?
  document      Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  items         ProductReceiptItem[]
  batches       Batch[]
  createdAt     DateTime             @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt     DateTime?

  @@index([status, date])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([number])
}

model ProductReceiptItem {
  id          Int            @id @default(autoincrement())
  receiptId   Int
  receipt     ProductReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product        @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  batchId     Int?
  batch       Batch?         @relation("ReceiptItemBatch", fields: [batchId], references: [id], onDelete: SetNull)
  quantity    Int
  unitPrice   Float
  costPrice   Float          @default(0)
  vatRate     Float          @default(12)
  vatAmount   Float          @default(0)
  totalAmount Float          @default(0)
  expiryDate  DateTime?
  serialNo    String?
}

model ProductIssue {
  id          Int                @id @default(autoincrement())
  number      String             @unique
  date        DateTime           @default(now())
  type        String             @default("Sale")
  warehouseId Int
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  customerId  Int?
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reason      String?
  totalAmount Float              @default(0)
  status      String             @default("Draft")
  notes       String?
  userId      Int
  user        User               @relation(fields: [userId], references: [id])
  documentId  Int?
  document    Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  items       ProductIssueItem[]
  createdAt   DateTime           @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt   DateTime?

  @@index([status, date, type])
  @@index([warehouseId])
  @@index([number])
}

model ProductIssueItem {
  id          Int          @id @default(autoincrement())
  issueId     Int
  issue       ProductIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  batchId     Int?
  batch       Batch?       @relation("IssueItemBatch", fields: [batchId], references: [id], onDelete: SetNull)
  quantity    Int
  unitPrice   Float
  costPrice   Float        @default(0)
  totalAmount Float        @default(0)
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRoleAssignment[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?
  resource    String?
  action      String?

  roles RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scope  String @default("ALL")

  @@unique([userId, roleId])
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  status       String    @default("New")
  priority     String    @default("Normal")
  dueDate      DateTime?
  assignedToId Int
  assignedTo   User      @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  Int
  createdBy    User      @relation("CreatedBy", fields: [createdById], references: [id])
  documentId   Int?
  orderId      Int?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt    DateTime?

  @@index([assignedToId, status])
  @@index([dueDate])
  @@index([status])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@index([type])
}

model ScheduledJob {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  cron       String
  handler    String
  params     Json?
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  lastStatus String?
  lastError  String?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
}

model ConfigObject {
  id          Int      @id @default(autoincrement())
  kind        String
  name        String
  description String?
  schema      Json
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}

model PrintTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  documentType String
  template     Json
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  locale      String   @default("ru-RU")
  layout      Json?
  paperSize   String   @default("A4")
  orientation String   @default("portrait")
  copies      Int      @default(1)
  isActive    Boolean  @default(true)
}

model PrintForm {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  applicableTypes String
  renderer        String
  isSystem        Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt
}
